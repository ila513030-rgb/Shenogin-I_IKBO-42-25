#!/bin/bash
for file in "$@"; do
    case "$file" in
        *.c)  pattern='^[[:space:]]*(//|/\*)' ;;
        *.js) pattern='^[[:space:]]*(//|/\*)' ;;
        *.py) pattern='^[[:space:]]*#' ;;
        *) continue ;;
    esac
    first=$(head -n 1 "$file")
    if echo "$first" | grep -Eq "$pattern"; then
        echo "$file: comment"
    else
        echo "$file: no comment"
    fi
done
